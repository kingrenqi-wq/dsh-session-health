{
  "name": "dsh-session-health",
  "version": "1.0.0",
  "description": "Floating session-health card for DeepSeek Harness: context fill plus evidence-backed hints when a session repeats failures or a task never finishes.",
  "keywords": ["deepseek", "deepseek-harness", "dsh", "dsh-plugin", "session", "context", "observability"],
  "license": "MIT",
  "type": "module",
  "private": false,
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "engines": { "node": ">=22.13.0" }
}
